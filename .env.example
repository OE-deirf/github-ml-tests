CHURN_DATA_PATH=data/raw/churn.csv
CHURN_ARTIFACTS_DIR=artifacts
CHURN_RANDOM_SEED=42
CHURN_LOG_LEVEL=INFO
CHURN_TEST_SIZE=0.2

# --- MinIO (S3-compatible store) ---
MINIO_ROOT_USER=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DVC_BUCKET=dvc
DVC_REMOTE=storage

# --- DVC / boto3 the HOST ---
# The HOST can reach MinIO via public port. Inside the container http://minio:9000 .
DVC_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=mlflow

MLFLOW_PORT=5500
# From HOST machine reach the mlflow (notebook, python -m churn.train)
# Inside the container: http://mlflow:5000.
MLFLOW_TRACKING_URI=http://localhost:5500
MLFLOW_EXPERIMENT_NAME=churn-prediction
MLFLOW_REGISTERED_MODEL=churn
MLFLOW_BUCKET=mlflow

# --- DataSource (scripts/fetch_data.py) ---
# If empty the host will try several endpoints and the public URL.
CHURN_SOURCE=
